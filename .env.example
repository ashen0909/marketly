# Copy this file to .env.local and set your own values.
# NEVER put secret/service-role keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
MARKETLY_SANDBOX_ENABLED=false
# Optional, set to your deployed domain for auth redirect allowlisting
NEXT_PUBLIC_SITE_URL=http://localhost:3000
